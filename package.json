{
  "name": "@yantrikos/openclaw-memory-yantrikdb",
  "version": "0.1.0",
  "description": "OpenClaw memory plugin backed by YantrikDB: recall with retrieval reasons, conflict-aware session briefings, and auto-capture over plain HTTP.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "memory",
    "yantrikdb",
    "agent-memory",
    "persistent-memory"
  ],
  "license": "MIT",
  "author": "Pranab Sarkar (https://pranab.co.in)",
  "homepage": "https://yantrikdb.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantrikos/openclaw-memory-yantrikdb.git"
  },
  "bugs": {
    "url": "https://github.com/yantrikos/openclaw-memory-yantrikdb/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "index.ts",
    "src",
    "types",
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "kind": "npm",
      "package": "@yantrikos/openclaw-memory-yantrikdb",
      "minHostVersion": ">=2026.7.0"
    },
    "compat": {
      "pluginApi": ">=2026.7.0"
    },
    "build": {
      "openclawVersion": "2026.8.1"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-test',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}